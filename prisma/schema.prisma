generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SpanishLevel {
  A1
  A2
  B1
  B2
  C1
  C2

  @@map("spanish_level")
}

enum UserRole {
  STUDENT
  TEACHER
  ADMIN

  @@map("user_role")
}

enum Difficulty {
  BEGINNER
  ELEMENTARY
  INTERMEDIATE
  UPPER_INTERMEDIATE
  ADVANCED
  MASTERY

  @@map("difficulties")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

model User {
  id                String       @id @default(cuid())
  name              String?
  email             String?      @unique
  emailVerified     DateTime?    @map("email_verified")
  password          String?
  image             String?
  level             SpanishLevel @default(A1)
  role              UserRole     @default(STUDENT)
  streak            Int          @default(0)
  lastActiveDate    DateTime?    @map("last_active_date")
  totalStudyMinutes Int          @default(0) @map("total_study_minutes")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  accounts         Account[]
  sessions         Session[]
  lessons          UserLessonProgress[]

  @@map("users")
}

model Lesson {
  id              String     @id @default(cuid())
  title           String
  slug            String     @unique
  description     String     @db.Text
  content         String     @db.Text
  difficulty      Difficulty
  level           SpanishLevel
  order           Int
  imageUrl        String?    @map("image_url")
  vocabularyJson  Json?      @map("vocabulary_json")
  grammarJson     Json?      @map("grammar_json")
  durationMinutes Int        @default(15) @map("duration_minutes")
  isPublished     Boolean    @default(false) @map("is_published")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  userProgress UserLessonProgress[]

  @@index([level, order])
  @@map("lessons")
}

model UserLessonProgress {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  lessonId         String    @map("lesson_id")
  isCompleted      Boolean   @default(false) @map("is_completed")
  completedAt      DateTime? @map("completed_at")
  quizScore        Float?    @map("quiz_score")
  timeSpentMinutes Int       @default(0) @map("time_spent_minutes")
  startedAt        DateTime  @default(now()) @map("started_at")
  lastAccessedAt   DateTime  @default(now()) @map("last_accessed_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("user_lesson_progress")
}