model Lesson {
  id              String     @id @default(cuid())
  title           String
  slug            String     @unique
  description     String     @db.Text
  content         String     @db.Text
  difficulty      Difficulty
  level           SpanishLevel
  order           Int
  imageUrl        String?    @map("image_url")
  vocabularyJson  Json?      @map("vocabulary_json")
  grammarJson     Json?      @map("grammar_json")
  durationMinutes Int        @default(15) @map("duration_minutes")
  isPublished     Boolean    @default(false) @map("is_published")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  userProgress UserLessonProgress[]
  chatSessions ChatSession[]
  flashcards   Flashcard[]

  @@index([level, order])
  @@map("lessons")
}

model UserLessonProgress {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  lessonId         String    @map("lesson_id")
  isCompleted      Boolean   @default(false) @map("is_completed")
  completedAt      DateTime? @map("completed_at")
  quizScore        Float?    @map("quiz_score")
  timeSpentMinutes Int       @default(0) @map("time_spent_minutes")
  startedAt        DateTime  @default(now()) @map("started_at")
  lastAccessedAt   DateTime  @default(now()) @map("last_accessed_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("user_lesson_progress")
}

model Flashcard {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  lessonId        String?   @map("lesson_id")
  spanishText     String    @map("spanish_text")
  englishText     String    @map("english_text")
  exampleSentence String?   @map("example_sentence")
  imageUrl        String?   @map("image_url")
  interval        Int       @default(0)
  easeFactor      Float     @default(2.5) @map("ease_factor")
  repetitions     Int       @default(0)
  nextReviewDate  DateTime  @default(now()) @map("next_review_date")
  lastReviewDate  DateTime? @map("last_review_date")
  lastRating      Int?      @map("last_rating")
  totalReviews    Int       @default(0) @map("total_reviews")
  totalCorrect    Int       @default(0) @map("total_correct")
  isMastered      Boolean   @default(false) @map("is_mastered")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson     Lesson?              @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  reviewLogs FlashcardReviewLog[]

  @@index([userId, nextReviewDate])
  @@map("flashcards")
}

model FlashcardReviewLog {
  id             String   @id @default(cuid())
  flashcardId    String   @map("flashcard_id")
  userId         String   @map("user_id")
  rating         Int
  responseTimeMs Int?     @map("response_time_ms")
  reviewedAt     DateTime @default(now()) @map("reviewed_at")

  flashcard Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("flashcard_review_logs")
}